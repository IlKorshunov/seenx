[
  {
    "seg_idx": 0,
    "start_sec": 0,
    "end_sec": 30,
    "n_frames": 15,
    "frames": [
      "seg_00_f00.jpg",
      "seg_00_f01.jpg",
      "seg_00_f02.jpg",
